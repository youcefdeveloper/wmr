# Postgres connection (Neon / Supabase / Vercel Postgres / local).
DATABASE_URL=postgres://postgres@127.0.0.1:5432/wmr
# Optional: max connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# Optional: leave empty to call the API on the same origin.
PUBLIC_API_BASE_URL=
# API keys sent as X-API-KEY (mobile app + dashboard).
PUBLIC_API_KEY=
PUBLIC_API_KEY_WEEKLY_DATA_MANUAL=

# Secret for the scheduled rates import (/api/cron/import-rates).
# Vercel Cron sends it as `Authorization: Bearer <value>`.
CRON_SECRET=

# Expo push service.
EXPO_API_BASE_URL=https://api.expo.dev/v2
# Optional: override the bundled MaxMind database location.
# GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# Auth.js (dashboard sign-in).
AUTH_SECRET=
AUTH_TRUST_HOST=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

RATES_MIN_START_DATE=1971-04-01
DEVICES_MIN_START_DATE=2025-07-01
PUBLIC_IMPORT_RATES_SOURCE_URL=https://www.freddiemac.com/pmms/docs/historicalweeklydata.xlsx
