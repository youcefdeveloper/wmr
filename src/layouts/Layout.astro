---
import '@assets/css/style.css'
import Footer from '@components/Footer.astro'
import Header from '@components/Header.astro'

import TitleTag from '@components/react/TitleTag'

const { title } = Astro.props
---

<!-- Server defaults match the stores' defaults (English); the script below
     switches to the visitor's stored language before anything is painted. -->
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Language and theme live in localStorage, which the server cannot see,
      // so the HTML arrives in the defaults (English, light) and the React
      // islands only switch after they hydrate and read storage. Apply both
      // here, before first paint, and keep the content hidden until every
      // island has hydrated in the stored language.
      ;(function () {
        var root = document.documentElement
        root.classList.add('wmr-loading')

        function stored(key) {
          try {
            var raw = localStorage.getItem(key)
            return raw ? JSON.parse(raw).state : null
          } catch (e) {
            return null
          }
        }

        var lang = (stored('mortgage_calculator_storage') || {}).lang
        if (lang === 'ar' || lang === 'en') {
          root.lang = lang
          root.dir = lang === 'ar' ? 'rtl' : 'ltr'
        }
        // 'dark' is the theme store's default when nothing is stored.
        var theme = (stored('theme_storage') || {}).theme || 'dark'
        if (theme === 'dark') root.classList.add('wmr-dark')

        // Capped so a failed island request can never leave the page blank.
        var MAX_WAIT_MS = 5000
        var start = Date.now()

        function settled() {
          return (
            document.readyState === 'complete' &&
            // Set by the language store once it has read localStorage.
            window.__wmrLangReady === true &&
            // A deferred server island is pending while its script is present.
            !document.querySelector('script[data-island-id]') &&
            // Astro removes `ssr` once an island has hydrated.
            !document.querySelector('astro-island[ssr]')
          )
        }

        function reveal() {
          // Two frames, so islands that re-rendered in the stored language
          // have painted before the content is shown.
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              root.classList.remove('wmr-loading')
            })
          })
        }

        var timer = setInterval(function () {
          var elapsed = Date.now() - start
          if (!settled() && elapsed < MAX_WAIT_MS) return
          clearInterval(timer)
          if (!document.fonts || elapsed >= MAX_WAIT_MS) return reveal()
          Promise.race([
            document.fonts.ready,
            new Promise(function (resolve) {
              setTimeout(resolve, MAX_WAIT_MS - elapsed)
            }),
          ]).then(reveal, reveal)
        }, 50)
      })()
    </script>
    <style is:inline>
      /* Opacity rather than visibility: descendants cannot override it. */
      html.wmr-loading body > * {
        opacity: 0;
      }
      /* The body only turns dark once ThemeToggle hydrates, so paint the dark
         background from here meanwhile instead of a white screen. */
      html.wmr-loading.wmr-dark {
        background-color: rgba(71, 71, 71, 1);
      }
    </style>
    <!-- Favicon and Touch Icons -->
    <link href="/favicon-32x32.png" rel="icon" sizes="32x32" type="image/png"/>
    <link href="/favicon-48x48.png" rel="icon" sizes="48x48" type="image/png"/>
    <link href="/android-chrome-192x192.png" rel="icon" sizes="192x192" type="image/png"/>
    <link href="/android-chrome-512x512.png" rel="icon" sizes="512x512" type="image/png"/>

    <!-- Apple Touch Icon (for iPad/iPhone Home Screen) -->
    <link href="/apple-touch-icon.png" rel="apple-touch-icon"/>

    <!-- Microsoft Tile Image (for Windows Start menu pinned sites) -->
    <meta content="/mstile-270x270.png" name="msapplication-TileImage"/>

    <!-- Fallback (optional) -->
    <link href="/favicon.png" rel="icon" type="image/svg+xml"/>

    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.rtl.min.css" 
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Hind+Madurai:wght@300;400;500;600;700&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Baloo+Bhaijaan+2:wght@400..800&family=Noto+Naskh+Arabic:wght@400..700&family=Vazirmatn:wght@100..900&family=Croissant+One&family=Abril+Fatface&&family=Chonburi&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      rel="stylesheet"
    />
    <TitleTag client:idle />
  </head>
  <body class="theme">
    <Header />
      <main class="container">
        <slot />
      </main>
    <Footer />
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
    {import.meta.env.MODE === 'production' && (
        <>
          <!-- Google tag (gtag.js) -->
          <script async src="https://www.googletagmanager.com/gtag/js?id=G-5QXFQQLT6E"></script>
          <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'G-5QXFQQLT6E');
          </script>
        </>
    )}
  </body>
</html>
