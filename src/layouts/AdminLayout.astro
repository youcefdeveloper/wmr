---
import '@assets/css/style_admin.css'
import '@assets/css/skeletons.css'
import Footer from '@components/admin/Footer.astro'
import Header from '@components/admin/Header.astro'
import SetUserFromApi from '@components/admin/react/SetUserFromApi'
import { getSession } from 'auth-astro/server'

const session = await getSession(Astro.request)
const userEmail = session?.user?.email ?? undefined

const { title } = Astro.props
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <!-- Favicon and Touch Icons -->
  <link href="/favicon-32x32.png" rel="icon" sizes="32x32" type="image/png" />
  <link href="/favicon-48x48.png" rel="icon" sizes="48x48" type="image/png" />
  <link href="/android-chrome-192x192.png" rel="icon" sizes="192x192" type="image/png" />
  <link href="/android-chrome-512x512.png" rel="icon" sizes="512x512" type="image/png" />

  <!-- Apple Touch Icon (for iPad/iPhone Home Screen) -->
  <link href="/apple-touch-icon.png" rel="apple-touch-icon" />

  <!-- Microsoft Tile Image (for Windows Start menu pinned sites) -->
  <meta content="/mstile-270x270.png" name="msapplication-TileImage" />

  <!-- Fallback (optional) -->
  <link href="/favicon.png" rel="icon" type="image/svg+xml" />

  <meta name="viewport" content="width=device-width" />
  <meta name="generator" content={Astro.generator} />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Hind+Madurai:wght@300;400;500;600;700&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
    rel="stylesheet"
  />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    rel="stylesheet"
  />
  <title>{title}</title>
</head>
<body>
  <div class="theme">
    {/* Set Zustand user globally for all admin pages */}
    <SetUserFromApi client:load email={userEmail} />
    <Header />
    <main class="container">
      <slot />
      <!-- <pre
        class="bg-light px-4 small fw-light mt-5">
        <p>Astro.props?</p>{JSON.stringify(Astro.props, undefined, 2)}
        <p>Astro.params?</p>{JSON.stringify(Astro.params, undefined, 2)}
        <p>Astro.url.searchParams?</p>{JSON.stringify(Astro.url.searchParams.get('categoryId'), undefined, 2)}
      </pre> -->
    </main>
    <Footer />
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
  <script is:client>
    function initTooltips() {
      document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach((el) => {
        // Only create a tooltip if it doesn't already exist
        if (!bootstrap.Tooltip.getInstance(el)) {
          new bootstrap.Tooltip(el);
        }
      });
    }

    // Run on first load
    window.addEventListener("load", initTooltips);

    // Re-run whenever React adds elements
    const observer = new MutationObserver(initTooltips);
    observer.observe(document.body, { childList: true, subtree: true });
  </script>
</body>
</html>