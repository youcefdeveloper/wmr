---
import Logo from '@components/admin/react/Logo'
import { getSession } from 'auth-astro/server'
import { canAccess } from '@lib/server/access'

const session = await getSession(Astro.request)
// Set by the middleware; hides links the `user` role would be redirected from.
const role = Astro.locals.role ?? null
const can = (path: string) => canAccess(role, path)

// The menu item for the page you are on is bold. A section also counts as
// current from its own pages, e.g. Devices while reading /dashboard/devices/42.
const { pathname } = Astro.url
const isCurrent = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname === href || pathname.startsWith(`${href}/`)
const current = (href: string) => (isCurrent(href) ? 'dropdown-item fw-bold' : 'dropdown-item')

const DEFAULT_AVATAR = 'data:image/jpeg;base64,'

// console.log('Header session:', session)
---

<header class="fixed-top">
  <div class="container d-flex justify-content-between align-items-center">
    <a href="/dashboard" class="d-flex justify-content-start align-items-center">
      <Logo client:idle />
    </a>
    <!-- <pre>{JSON.stringify(session, null, 2)}</pre> -->
    <div class="d-flex justify-content-start align-items-center">
      {
        session ?
          <div class="d-none-- d-md-block--">
            <!--<a href="/">Home</a>-->
            <!--<a href="/about" class="ms-3"> About </a>-->
            <!--<a href="/auth/login" class="ms-3"> Login </a>-->
            <span class="dropdown position-relative">
          <a
            href="#"
            class={`ms-3 dropdown-toggle d-flex align-items-center gap-2`}
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            {session.user?.image ? (
              <img
                src={session.user.image}
                alt={session.user?.name || 'User'}
                width="32"
                height="32"
                class="rounded-circle"
                style="object-fit: cover;"
                referrerpolicy="no-referrer"
                data-avatar-fallback
              />
            ) : (
              <img
                src={DEFAULT_AVATAR}
                alt={session.user?.name || 'User'}
                width="32"
                height="32"
                class="rounded-circle"
                style="object-fit: cover;"
              />
            )}
            <span>Hi, {session.user?.name}</span>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class={current("/dashboard/my-account")} href="/dashboard/my-account" aria-current={isCurrent("/dashboard/my-account") ? "page" : undefined}>My Account</a></li>
            <li><hr class="dropdown-divider" /></li>
            {can('/dashboard/accounts') && <li><a class={current("/dashboard/accounts")} href="/dashboard/accounts" aria-current={isCurrent("/dashboard/accounts") ? "page" : undefined}>Accounts</a></li>}
            {can('/dashboard/devices') && <li><a class={current("/dashboard/devices")} href="/dashboard/devices" aria-current={isCurrent("/dashboard/devices") ? "page" : undefined}>Devices</a></li>}
            <li><a class={current("/dashboard/rates")} href="/dashboard/rates" aria-current={isCurrent("/dashboard/rates") ? "page" : undefined}>Rates</a></li>
             <li><a class={current("/dashboard/visits")} href="/dashboard/visits" aria-current={isCurrent("/dashboard/visits") ? "page" : undefined}>Visits</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item" href="/" target="_blank" rel="noopener">View Site</a></li>
            {can('/api-docs') && <li><a class={current("/api-docs")} href="/api-docs" aria-current={isCurrent("/api-docs") ? "page" : undefined} target="_blank" rel="noopener">API Docs</a></li>}
            <li><hr class="dropdown-divider" /></li>
            <li><button class="dropdown-item" id="logout">Logout</button></li>
          </ul>
        </span>
          </div> : (
            <></>)
      }
      <div class="mode-toggle  ms-4 d-none">
        <a
          href="#"
          @click.prevent="toggleTheme()"
          :class="isDark ? 'bi bi-brightness-high fs-5' : 'bi bi-moon fs-5'"></a>
      </div>
    </div>
  </div>
</header>

<script>
  const { signOut } = await import('auth-astro/client')
  const logoutBtn = document.querySelector('#logout')
  if (logoutBtn) logoutBtn.onclick = () => signOut()
</script>

<!-- A provider's avatar host can refuse or be blocked; show the placeholder
     rather than a broken image. Covers an image that already failed before
     this ran, which is why `complete` is checked as well. -->
<script is:inline define:vars={{ fallback: DEFAULT_AVATAR }}>
  for (const img of document.querySelectorAll('img[data-avatar-fallback]')) {
    const swap = () => {
      img.src = fallback
    }
    if (img.complete && img.naturalWidth === 0) swap()
    else img.addEventListener('error', swap, { once: true })
  }
</script>