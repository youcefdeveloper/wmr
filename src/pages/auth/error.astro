---
import Layout from '@layouts/AuthLayout.astro'
import ErrorCard from '@components/admin/react/ErrorCard'

const error = Astro.url.searchParams.get('error')
---

<Layout title="WMR | Error">
  <div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="container-lg py-5">
      <div class="row">
        <div class="col-md-7 col-lg-6 col-xl-5 mx-auto px-0">
          <ErrorCard client:load errorType={error} />
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    function themeToggle() {
      return {
        isDark: false,
        init() {
          this.isDark = localStorage.getItem('admin_theme_storage.state.theme') === 'dark'
        },
      }
    }
  </script>
</Layout>
