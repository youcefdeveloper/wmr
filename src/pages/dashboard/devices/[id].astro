---
import Layout from '@layouts/AdminLayout.astro'
import { tryLoad } from '@lib/server/http'
import { pageDeviceHistory } from '@lib/server/history'
import DeviceUpdatesHistoryGrid from '@components/admin/react/devices/DeviceUpdatesHistoryGrid.tsx'
import type { Filter } from '@admin-types/adminTypes'

const { id } = Astro.params

// ✅ Server-side load once (SSR)
const getUserUpdatesHistory = (q: URLSearchParams): Promise<any | undefined> =>
  tryLoad('device history', () =>
    pageDeviceHistory(Number(id), {
      page: parseInt(q.get('page') ?? '', 10) || 1,
      size: parseInt(q.get('size') ?? '', 10) || 10,
      order: q.get('order')?.toLowerCase() === 'asc' ? 'asc' : 'desc',
      source: q.get('source'),
      start: q.get('start'),
      end: q.get('end'),
    }),
  )

// ✅ Build query params (SSR-safe)
const url = new URL(Astro.request.url)
const queryParams = new URLSearchParams(url.search)

function setParam(key: string, value: string | null) {
  if (value && value.trim() !== '') {
    queryParams.set(key, value)
  } else {
    queryParams.delete(key)
  }
}

const page = Astro.url.searchParams.get('page')
const size = Astro.url.searchParams.get('size')
const order = Astro.url.searchParams.get('order')
const start = Astro.url.searchParams.get('start')
const end = Astro.url.searchParams.get('end')

// ✅ Apply parameters
setParam('page', page)
setParam('size', size)
setParam('order', order)
setParam('start', start)
setParam('end', end)

// ✅ SSR load (unknown device → 404, which the middleware redirects home)
const userUpdatesHistory = /^\d+$/.test(id ?? '')
  ? await getUserUpdatesHistory(queryParams)
  : undefined
if (!userUpdatesHistory) {
  return new Response(null, { status: 404 })
}
const { userId, deviceId, platform, model, createdAt, filter: filterParams, data, ...meta } = userUpdatesHistory

// ✅ Pagination metadata
const filterMeta = {
  fromPage: meta.from,
  page: meta.page,
  itemsPerPage: meta.size,
  toPage: meta.to,
  totalPages: meta.pages,
  totalItems: meta.total,
}

// ✅ Build filter object (for hydration)
const filter: Filter = {
  size: size ? parseInt(size) : 10,
  page: page ? parseInt(page) : 1,
  start: start && start.trim() !== '' ? start.trim() : null,
  end: end && end.trim() !== '' ? end.trim() : null,
  order: order && order.trim() !== '' ? (order.toLowerCase() as 'asc' | 'desc') : null,
}
---

<Layout
  title=`WMR |  ${model || 'Unknown'} (${platform === 'ios' ? 'iOS' : platform === 'android' ? 'Android' : 'Unknown'})`>

  <a href="/dashboard/devices?uOrder=desc" class="d-inline-flex align-items-center gap-1 mb-3 fw-light"
     style={{ marginLeft: '-5px' }}>
    <span class="bi bi-chevron-left" style={{ marginTop: '1px' }}></span>
    <span>ALL DEVICES</span>
  </a>

  <!-- ✅ React grid now fully SPA-aware -->
  <DeviceUpdatesHistoryGrid
    client:only
    fromPage={meta.from}
    toPage={meta.to}
    totalItems={meta.total}
    devices={data}
    filter={filter}
    filterMeta={filterMeta}
    model={model}
    platform={platform}
    userId={userId}
    createdAt={createdAt}
  />
</Layout>