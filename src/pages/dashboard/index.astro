---

<Layout title="WMR | Dashboard">

  <div class="row">
      <div class="col-lg-6 mb-4">
        <CurrentRates />
      </div>
      <div class="col-lg-6 mb-4">
        <ReturningCard client:only data={userStats} />
      </div>
      <div class="col-lg-6 mb-4">
        <DeviceUpdatesHistoryCard client:only data={userStats} />
      </div>
      <div class="col-lg-6 mb-4">
        <DeviceCard client:only title="All Devices" totalDevices={totalDevices} isTitleLinked chartType="pie">
          <DevicesChart client:only data={data} />
        </DeviceCard>
      </div>
      <div class="col-lg-6 mb-4">
        <DeviceCard 
          client:only 
          title="iOS Devices"
          totalDevices={totalIOSDevices}
          chartType="bar"
          platform={'ios'}>
          <DeviceChart
            client:only
            data={iOSDeviceData}
            platform={'ios'}
          />
        </DeviceCard>
      </div>
      <div class="col-lg-6 mb-4">
        <DeviceCard 
          client:only 
          title="Android Devices" 
          totalDevices={totalAndroidDevices} 
          chartType="bar"
          platform={'android'}>
          <DeviceChart
            client:only
            data={androidDeviceData}
            platform={'android'}
          />
        </DeviceCard>
      </div>
      <!-- <div class="col-lg-12 mb-4">
