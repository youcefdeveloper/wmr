import DeviceChart from '@components/admin/react/DeviceChart'
import { tryLoad } from '@lib/server/http'
import { getDeviceStats, getDeviceStatsByModel } from '@lib/server/devices'
import {
  buildDevicesChartData,
  buildDeviceData,
  type PlatformData,
  type Device,
  type NewPlatformData,
} from '@utils/common'
import DeviceCard from '@components/admin/react/DeviceCard'
import DeviceUpdatesHistoryCard from '@components/admin/react/DeviceUpdatesHistoryCard'
import CurrentRates from './partial/CurrentRates.astro'
import ReturningCard from '@components/admin/react/ReturningCard.tsx'

import { getSession } from 'auth-astro/server'
import type { CountryData } from '@admin-types/adminTypes'

const session = await getSession(Astro.request)
const userEmail = session?.user?.email ?? undefined

function sumTotals(data: CountryData[]): number {
  return data.reduce((sum, country) => sum + country.total, 0);
}

const getUserStats = () => tryLoad('device stats', getDeviceStats)

const getUserStatsByModel = () =>
  tryLoad('device stats by model', getDeviceStatsByModel)

