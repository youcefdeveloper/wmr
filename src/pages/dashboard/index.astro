const userStats = ((await getUserStats()) ?? []) as NewPlatformData[]
const deviceStats = userStats
  .filter((item): item is NewPlatformData & { platform: Exclude<string, 'all'> } => item.platform !== 'all')
  .map(({ platform, total }): PlatformData => ({ platform, total }))

// const extractStats = (platform: string): ReturningStats | null => {
//   const stat = userStats.find(item => item.platform === platform)
//   if (!stat) return null
//   return {
//     returning: stat.returning ?? 0,
//     oneTime: stat.oneTime ?? 0,
//   }
// }

const totalDevices: number = deviceStats.reduce((sum: number, item: PlatformData) => sum + item.total, 0)
const data = buildDevicesChartData([...deviceStats].reverse())

// console.log('deviceStats?', deviceStats)
// const returningAllPlatform = buildReturningChartData([...returningAllStats].reverse())

const userStatsByModel: Record<string, Device[]> =
  (await getUserStatsByModel()) ?? {}
const totalIOSDevices: number = userStatsByModel.ios?.reduce((sum: number, device: Device) => sum + device.total, 0)
const totalAndroidDevices: number = userStatsByModel.android?.reduce((sum: number, device: Device) => sum + device.total, 0)
const iOSDeviceData = buildDeviceData(userStatsByModel.ios)
const androidDeviceData = buildDeviceData(userStatsByModel.android)

const currentYear = new Date().getFullYear()
const years = Array.from({ length: currentYear - 1970 }, (_, i) => 1971 + i)
const firstYear = years[0]
const lastYear = years[years.length - 1]
const selectedYear =
  firstYear && Number(firstYear) >= 1971 && Number(firstYear) <= currentYear
    ? Number(firstYear)
    : currentYear

